@model List<SportCourtManagement_FrontEnd.Models.Bookings.SingularBookingResponseDto>

@{
    var firstBooking = Model.FirstOrDefault() ?? new SportCourtManagement_FrontEnd.Models.Bookings.SingularBookingResponseDto();
    var isServicePayment = ViewBag.IsServicePayment as bool? ?? false;
    ViewData["Title"] = isServicePayment ? "Thanh toán dịch vụ mua thêm" : "Thanh toán đơn hàng";
    var qrCode = ViewBag.QrCode as SportCourtManagement_FrontEnd.Models.Bookings.SePayQrCodeDto;
    var totalAmount = ViewBag.TotalAmount as decimal? ?? Model.Sum(b => b.TotalAmount);
    var bookingCodesStr = ViewBag.BookingCodes as string ?? string.Join(",", Model.Select(b => b.BookingCode));
}

<main class="sc-container py-5">
    <div class="row justify-content-center">
        <div class="col-lg-7">
            <div class="sc-card p-0" style="background-color: #0D121F; border: 1px solid rgba(79, 110, 247, 0.2); box-shadow: 0 8px 32px rgba(0,0,0,0.4); overflow: hidden;">

                <!-- Header Gradient Banner -->
                <div class="text-center py-4 px-4" style="background: linear-gradient(135deg, rgba(79, 110, 247, 0.15) 0%, rgba(16, 185, 129, 0.08) 100%); border-bottom: 1px solid rgba(255,255,255,0.05);">
                    <div class="d-inline-flex align-items-center justify-content-center rounded-circle mb-3" style="width: 64px; height: 64px; background: rgba(245, 158, 11, 0.1); border: 2px solid rgba(245, 158, 11, 0.3);">
                        <i class="bi bi-wallet2 text-warning" style="font-size: 28px;"></i>
                    </div>
                    <h3 class="text-white font-outfit fw-bold mb-1">@(isServicePayment ? "Thanh Toán Dịch Vụ Mua Thêm" : "Thanh Toán Đặt Sân")</h3>
                    <p class="text-sc-muted mb-0 small">@(isServicePayment ? "Quét mã QR dưới đây để thanh toán bổ sung cho dịch vụ mua thêm" : "Quét mã QR dưới đây để hoàn tất thanh toán cho các đơn đặt sân")</p>
                </div>

                <div class="p-4">
                    <!-- Booking Code Badges Container (Scrollable if > 4 items) -->
                    <div class="text-center mb-4">
                        @if (Model.Count > 4)
                        {
                            <div class="d-inline-block p-2 px-3 rounded-pill mb-2" style="background: rgba(79, 110, 247, 0.15); border: 1px solid rgba(79, 110, 247, 0.3); font-size: 13px;">
                                <i class="bi bi-calendar2-range text-sc-amber me-1"></i>
                                <span class="text-white fw-bold">Tổng cộng @Model.Count đơn đặt sân</span>
                            </div>
                            <div class="d-flex flex-wrap justify-content-center gap-1 p-2 rounded-3" style="max-height: 100px; overflow-y: auto; background: rgba(255,255,255,0.02); border: 1px solid rgba(255,255,255,0.05);">
                                @foreach (var booking in Model)
                                {
                                    <span class="px-2 py-1 rounded font-monospace" style="background: rgba(79, 110, 247, 0.1); font-size: 11px; color: #A5B4FC;">
                                        #@booking.BookingCode
                                    </span>
                                }
                            </div>
                        }
                        else
                        {
                            <div class="d-flex flex-wrap justify-content-center gap-2">
                                @foreach (var booking in Model)
                                {
                                    <span class="d-inline-flex align-items-center gap-1 px-3 py-2 rounded-pill" style="background: rgba(79, 110, 247, 0.1); border: 1px solid rgba(79, 110, 247, 0.3); font-size: 12px;">
                                        <i class="bi bi-hash text-sc-blue-light"></i>
                                        <span class="text-white fw-bold font-monospace">@booking.BookingCode</span>
                                    </span>
                                }
                            </div>
                        }
                    </div>

                    <!-- Bookings Details List (Scrollable box) -->
                    <div class="p-3 rounded mb-4" style="background-color: #141B2D; border: 1px solid var(--sc-border); font-size: 13.5px;">
                        <div class="d-flex justify-content-between align-items-center mb-3">
                            <h6 class="text-white font-outfit mb-0" style="font-weight: 700;">
                                <i class="bi bi-receipt me-1 text-sc-blue-light"></i> @(isServicePayment ? "Chi tiết dịch vụ mua thêm" : $"Chi tiết đơn hàng ({Model.Count} buổi)")
                            </h6>
                            @if (Model.Count > 3)
                            {
                                <span class="badge bg-secondary bg-opacity-20 text-sc-muted" style="font-size: 11px;"><i class="bi bi-arrows-expand me-1"></i>Cuộn để xem tất cả</span>
                            }
                        </div>

                        <!-- Scrollable Items Container -->
                        <div style="max-height: 320px; overflow-y: auto; padding-right: 6px;">
                            @for (int i = 0; i < Model.Count; i++)
                            {
                                var booking = Model[i];
                                <div class="mb-3 @(i > 0 ? "pt-3 border-top" : "")" style="@(i > 0 ? "border-top-color: rgba(255, 255, 255, 0.05) !important;" : "")">
                                    <div class="d-flex justify-content-between mb-1">
                                        <span class="text-sc-blue-light fw-bold">#@booking.BookingCode</span>
                                        <span class="text-sc-green fw-bold">@booking.TotalAmount.ToString("N0")đ</span>
                                    </div>
                                    @if (!isServicePayment)
                                    {
                                        <div class="d-flex justify-content-between mb-1" style="font-size: 12.5px;">
                                            <span class="text-sc-muted">Sân đấu:</span>
                                            <span class="text-white">@booking.CourtName</span>
                                        </div>
                                        <div class="d-flex justify-content-between mb-1" style="font-size: 12.5px;">
                                            <span class="text-sc-muted">Ngày:</span>
                                            <span class="text-white">@booking.BookingDate.ToString("dd/MM/yyyy")</span>
                                        </div>
                                        <div class="d-flex justify-content-between mb-1" style="font-size: 12.5px;">
                                            <span class="text-sc-muted">Khung giờ:</span>
                                            <span class="text-white">
                                                @if (!string.IsNullOrEmpty(booking.SlotName))
                                                {
                                                    @booking.SlotName @($"({booking.StartTime:hh\\:mm} - {booking.EndTime:hh\\:mm})")
                                                }
                                                else
                                                {
                                                    @($"{booking.StartTime:hh\\:mm} - {booking.EndTime:hh\\:mm}")
                                                }
                                            </span>
                                        </div>
                                    }

                                    @if (booking.BookingServices != null && booking.BookingServices.Any())
                                    {
                                        <div class="mt-2 pt-2 border-top border-white border-opacity-10" style="font-size: 12.5px;">
                                            <span class="text-sc-muted d-block mb-1 font-outfit fw-bold"><i class="bi bi-bag-plus text-warning me-1"></i>Dịch vụ bổ sung:</span>
                                            @foreach (var svc in booking.BookingServices)
                                            {
                                                <div class="d-flex justify-content-between align-items-center text-white py-1 px-2 mb-1 rounded" style="background: rgba(255,255,255,0.03);">
                                                    <span>• @svc.ServiceName <span class="text-white-50">(@svc.Price.ToString("N0")đ/đơn vị)</span> x<strong class="text-white">@svc.Quantity</strong></span>
                                                    <span class="text-sc-green fw-bold">@svc.TotalPrice.ToString("N0")đ</span>
                                                </div>
                                            }
                                        </div>
                                    }
                                </div>
                            }
                        </div>

                        @if (!isServicePayment && Model.Any(b => b.DiscountAmount > 0))
                        {
                            <div class="d-flex justify-content-between text-sc-green mt-2">
                                <span>Giảm giá:</span>
                                <span>-@Model.Sum(b => b.DiscountAmount).ToString("N0")đ</span>
                            </div>
                        }
                        <hr style="border-color: rgba(255,255,255,0.05); margin: 12px 0;" />
                        <div class="d-flex justify-content-between align-items-baseline mt-3 pt-2">
                            <span class="text-white fw-bold" style="font-size: 15px;">@(isServicePayment ? "Tổng tiền dịch vụ mua thêm:" : "Tổng cộng:")</span>
                            <span class="font-outfit text-sc-green fw-black" style="font-size: 26px; font-weight: 900;">@totalAmount.ToString("N0")đ</span>
                        </div>
                    </div>

                    <!-- VietQR Direct Payment Section -->
                    @if (qrCode != null && !string.IsNullOrEmpty(qrCode.QrCodeUrl))
                    {
                        <div class="p-4 rounded-3 mb-4 text-center" style="background-color: #141B2D; border: 1px solid rgba(79, 110, 247, 0.3); box-shadow: 0 4px 20px rgba(0,0,0,0.3);">
                            <div class="d-flex align-items-center justify-content-between mb-3 pb-2 border-bottom border-white border-opacity-10">
                                <h6 class="text-white font-outfit mb-0 fw-bold">
                                    <i class="bi bi-qr-code-scan me-2 text-primary"></i>Quét mã VietQR thanh toán tự động
                                </h6>
                                <span class="badge bg-primary bg-opacity-20 text-primary px-3 py-1 font-monospace" id="countdownTimer">
                                    <i class="bi bi-clock me-1"></i>14:59
                                </span>
                            </div>

                            <p class="text-sc-muted small mb-3">Mở ứng dụng Ngân hàng bất kỳ hoặc Ví điện tử để quét mã QR bên dưới:</p>

                            <!-- QR Image Container -->
                            <div class="d-inline-block p-3 bg-white rounded-4 shadow-lg mb-3">
                                <img src="@qrCode.QrCodeUrl" alt="VietQR Payment" class="img-fluid" style="width: 260px; height: 260px; object-fit: contain;" />
                            </div>

                            <!-- Transfer Info Details -->
                            <div class="text-start bg-dark p-3 rounded-3 mb-3 small border border-secondary border-opacity-25">
                                <div class="d-flex justify-content-between align-items-center mb-2">
                                    <span class="text-white-50">Ngân hàng thụ hưởng:</span>
                                    <strong class="text-white">@(qrCode.BankBin == "970415" ? "VietinBank" : (qrCode.BankBin == "970422" ? "MBBank" : "Ngân hàng"))</strong>
                                </div>
                                <div class="d-flex justify-content-between align-items-center mb-2">
                                    <span class="text-white-50">Số tài khoản:</span>
                                    <div class="d-flex align-items-center gap-2">
                                        <strong class="text-white font-monospace" id="accNumber">@qrCode.AccountNumber</strong>
                                        <button type="button" class="btn btn-sm btn-outline-secondary py-0 px-2 text-white-50" onclick="copyText('@qrCode.AccountNumber', 'Đã chép số tài khoản!')" title="Sao chép">
                                            <i class="bi bi-clipboard"></i>
                                        </button>
                                    </div>
                                </div>
                                <div class="d-flex justify-content-between align-items-center mb-2">
                                    <span class="text-white-50">Chủ tài khoản:</span>
                                    <strong class="text-white text-uppercase">@qrCode.AccountName</strong>
                                </div>
                                <div class="d-flex justify-content-between align-items-center mb-2">
                                    <span class="text-white-50">Số tiền:</span>
                                    <strong class="text-sc-green fs-6 fw-bold">@totalAmount.ToString("N0")đ</strong>
                                </div>
                                <div class="d-flex justify-content-between align-items-center pt-2 border-top border-white border-opacity-10">
                                    <span class="text-warning fw-semibold">Nội dung chuyển khoản:</span>
                                    <div class="d-flex align-items-center gap-2">
                                        <strong class="text-warning font-monospace fs-6 px-2 py-1 rounded" style="background: rgba(245, 158, 11, 0.15);" id="memoCode">@qrCode.BookingCode</strong>
                                        <button type="button" class="btn btn-sm btn-outline-warning py-0 px-2" onclick="copyText('@qrCode.BookingCode', 'Đã chép nội dung!')" title="Sao chép nội dung">
                                            <i class="bi bi-clipboard"></i>
                                        </button>
                                    </div>
                                </div>
                            </div>

                            <!-- Live Waiting Pulse -->
                            <div class="d-flex align-items-center justify-content-center gap-2 text-warning small py-2 px-3 rounded-pill" style="background: rgba(245, 158, 11, 0.08); border: 1px solid rgba(245, 158, 11, 0.2);">
                                <span class="spinner-grow spinner-grow-sm text-warning" role="status"></span>
                                <span id="pollingStatusText">Đang chờ bạn chuyển khoản... Hệ thống sẽ tự động cập nhật ngay khi nhận được tiền.</span>
                            </div>
                        </div>
                    }

                    <!-- Wallet Payment Section (Alternative) -->
                    @{
                        var wallet = ViewBag.Wallet as SportCourtManagement_FrontEnd.Models.DTOs.WalletDto;
                        var hasEnough = wallet != null && wallet.Balance >= totalAmount;
                    }

                    <div class="p-4 rounded-3 mb-4 text-center" style="background-color: #141B2D; border: 1px solid rgba(255,255,255,0.05);">
                        @Html.AntiForgeryToken()
                        <h6 class="text-white font-outfit mb-3" style="font-weight: 700;">
                            <i class="bi bi-wallet2 me-1 text-sc-blue-light"></i> Hoặc thanh toán bằng Ví điện tử
                        </h6>
                        
                        <div class="d-flex justify-content-center gap-4 mb-3 text-start bg-dark p-3 rounded">
                            <div>
                                <span class="text-white-50 small">Số dư ví của bạn:</span>
                                <h5 class="text-white fw-bold mt-1">@(wallet?.Balance.ToString("N0") ?? "0")đ</h5>
                            </div>
                            <div class="border-start border-secondary opacity-25"></div>
                            <div>
                                <span class="text-white-50 small">Số tiền cần thanh toán:</span>
                                <h5 class="text-sc-green fw-bold mt-1">@totalAmount.ToString("N0")đ</h5>
                            </div>
                        </div>

                        @if (hasEnough)
                        {
                            <button type="button" id="btnPayWithWallet" class="sc-btn sc-btn-primary w-100 py-3 d-flex align-items-center justify-content-center gap-2" style="border-radius: 12px; font-weight: 600;">
                                <i class="bi bi-shield-check"></i> Xác nhận thanh toán từ Ví
                            </button>
                        }
                        else
                        {
                            <div class="alert alert-secondary border-0 small text-start py-2 px-3 mb-3 text-white-50" style="background: rgba(255, 255, 255, 0.05);">
                                <i class="bi bi-info-circle me-1"></i> Số dư ví chưa đủ (@((totalAmount - (wallet?.Balance ?? 0)).ToString("N0"))đ còn thiếu). Bạn có thể quét mã VietQR ở trên để thanh toán trực tiếp ngay!
                            </div>
                        }
                    </div>

                    <!-- Action Buttons -->
                    <div class="d-flex flex-column gap-3">
                        <a asp-controller="MyBookings" asp-action="Index" class="sc-btn sc-btn-secondary w-100 py-3 font-outfit text-center d-block text-decoration-none" style="font-size: 14px; border-radius: 12px;">
                            <i class="bi bi-arrow-left me-1"></i> Quay lại danh sách đặt sân
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</main>

@section Scripts {
    <!-- Payment Success Modal -->
    <div class="modal fade" id="paymentSuccessModal" data-bs-backdrop="static" data-bs-keyboard="false" tabindex="-1" aria-hidden="true" style="backdrop-filter: blur(8px);">
        <div class="modal-dialog modal-dialog-centered" style="max-width: 440px;">
            <div class="modal-content text-center p-4" style="background: linear-gradient(145deg, #0F172A, #1E293B); border: 1px solid rgba(16, 185, 129, 0.4); border-radius: 24px; box-shadow: 0 16px 48px rgba(16, 185, 129, 0.25);">
                <div class="modal-body py-4">
                    <div class="d-inline-flex align-items-center justify-content-center rounded-circle mb-3" style="width: 80px; height: 80px; background: rgba(16, 185, 129, 0.15); border: 2px solid rgba(16, 185, 129, 0.5);">
                        <i class="bi bi-check-circle-fill text-success" style="font-size: 42px;"></i>
                    </div>
                    <h4 class="text-white font-outfit fw-bold mb-2">Thanh Toán Thành Công!</h4>
                    <p class="text-white-50 small mb-4">Hệ thống đã nhận được tiền chuyển khoản qua VietQR. Đơn đặt sân của bạn đã được xác nhận thành công!</p>
                    <div class="spinner-border spinner-border-sm text-success me-2" role="status"></div>
                    <span class="text-sc-green small fw-semibold">Đang chuyển tiếp tới chi tiết đặt sân...</span>
                </div>
            </div>
        </div>
    </div>

    <style>
        .sc-card:hover {
            transform: none !important;
        }
    </style>

    <script>
        function copyText(text, message) {
            navigator.clipboard.writeText(text).then(function() {
                var toastEl = $('<div class="position-fixed bottom-0 end-0 p-3" style="z-index: 9999;">' +
                    '<div class="toast show align-items-center text-white bg-success border-0 shadow" role="alert">' +
                    '<div class="d-flex"><div class="toast-body"><i class="bi bi-check-circle me-2"></i>' + message + '</div></div>' +
                    '</div></div>');
                $('body').append(toastEl);
                setTimeout(function() { toastEl.fadeOut(300, function() { $(this).remove(); }); }, 2000);
            });
        }

        $(document).ready(function () {
            var bookingCodes = '@bookingCodesStr';
            var isServicePayment = @(isServicePayment ? "true" : "false");

            // Auto-polling payment status every 2.5s
            var isPolling = true;
            var pollInterval = setInterval(function() {
                if (!isPolling) return;
                $.ajax({
                    url: '/Booking/CheckStatus',
                    type: 'GET',
                    data: {
                        bookingCodes: bookingCodes,
                        isServicePayment: isServicePayment
                    },
                    success: function(res) {
                        if (res && res.allPaid) {
                            isPolling = false;
                            clearInterval(pollInterval);
                            $('#pollingStatusText').html('<strong class="text-success"><i class="bi bi-check-circle-fill me-1"></i>Đã nhận thanh toán! Đang chuyển hướng...</strong>');
                            var modal = new bootstrap.Modal(document.getElementById('paymentSuccessModal'));
                            modal.show();
                            setTimeout(function() {
                                window.location.href = res.redirectUrl || ('/Booking/Success?bookingCodes=' + bookingCodes);
                            }, 1800);
                        }
                    }
                });
            }, 2500);

            // 15-minute countdown timer
            var timeLeft = 15 * 60;
            var timerInterval = setInterval(function() {
                timeLeft--;
                if (timeLeft <= 0) {
                    clearInterval(timerInterval);
                    $('#countdownTimer').html('<i class="bi bi-exclamation-triangle me-1"></i>Hết hạn');
                    $('#pollingStatusText').text('Phiên thanh toán đã hết hạn. Vui lòng đặt lại.');
                    return;
                }
                var m = Math.floor(timeLeft / 60);
                var s = timeLeft % 60;
                $('#countdownTimer').html('<i class="bi bi-clock me-1"></i>' + (m < 10 ? '0' : '') + m + ':' + (s < 10 ? '0' : '') + s);
            }, 1000);

            $('#btnPayWithWallet').click(function() {
                var btn = $(this);
                btn.prop('disabled', true).html('<span class="spinner-border spinner-border-sm" role="status" aria-hidden="true"></span> Đang xử lý...');

                $.ajax({
                    url: '/Booking/PayWithWallet',
                    type: 'POST',
                    data: {
                        bookingCodes: bookingCodes,
                        isServicePayment: isServicePayment,
                        __RequestVerificationToken: $('input[name="__RequestVerificationToken"]').val()
                    },
                    success: function(res) {
                        if (res.success) {
                            isPolling = false;
                            clearInterval(pollInterval);
                            window.location.href = res.redirectUrl;
                        } else {
                            alert(res.message || "Thanh toán thất bại.");
                            btn.prop('disabled', false).html('<i class="bi bi-shield-check"></i> Xác nhận thanh toán từ Ví');
                        }
                    },
                    error: function() {
                        alert("Lỗi kết nối máy chủ.");
                        btn.prop('disabled', false).html('<i class="bi bi-shield-check"></i> Xác nhận thanh toán từ Ví');
                    }
                });
            });
        });
    </script>
}
